{
  "fixtureVersion": "1.0",
  "title": "Horizon Radar V2 Observation Fixture 1.0",
  "status": "FROZEN",
  "synthetic": true,
  "purpose": "Independent deterministic Observation identity and input-validation fixture; not a real-world Radar replay.",
  "architecture": {
    "eventReplay": "SEPARATE",
    "observationReplay": "SEPARATE"
  },
  "requiredFields": [
    "eventKey",
    "radar",
    "sourceName",
    "sourceUrl",
    "sourceLevel",
    "observedAt"
  ],
  "allowedValues": {
    "radar": [
      "ai",
      "dev",
      "app",
      "security",
      "skill"
    ],
    "sourceLevel": [
      "official",
      "research",
      "ecosystem",
      "media",
      "community"
    ],
    "sourceAuthority": [
      "official",
      "primary",
      "secondary",
      "community"
    ]
  },
  "identityAlgorithm": {
    "status": "FROZEN",
    "inputs": [
      "eventKey",
      "canonicalSourceUrl",
      "radar"
    ],
    "encoding": "UTF-8(eventKey + \"\\n\" + canonicalSourceUrl + \"\\n\" + radar)",
    "digest": "SHA-256",
    "observationId": "first 16 lowercase hexadecimal characters",
    "excludes": [
      "entity",
      "date",
      "observedAt",
      "retrievedAt",
      "sourcePublishedAt",
      "sourceName",
      "sourceLevel",
      "sourceAuthority",
      "eventOccurredAt"
    ]
  },
  "urlCanonicalization": {
    "version": "candidate-1.0",
    "scheme": "lowercase; http/https only",
    "hostname": "lowercase",
    "fragment": "remove",
    "defaultPort": "remove (http:80, https:443)",
    "trailingSlash": "remove trailing slash(es) from non-root path; root remains /",
    "path": "preserve",
    "query": "preserve byte/order; do not strip tracking parameters, sort unknown parameters, decode semantic URLs, follow redirects, or use network/fuzzy matching"
  },
  "timeSemantics": {
    "observedAt": "required explicit ISO 8601 date-time; time Radar observed source",
    "firstSeen": "minimum observedAt among observations for same eventKey",
    "lastSeen": "maximum observedAt among observations for same eventKey",
    "forbiddenInference": [
      "report date",
      "sourcePublishedAt",
      "retrievedAt"
    ],
    "retrievedAt": "Local state only; fetch/read time and excluded from identity."
  },
